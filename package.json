{
    "name": "installment-prices-for-woocommerce",
    "description": "React settings screen (shadcn/ui on core's React, Tailwind v4) and E2E tooling for the Installment Prices for WooCommerce plugin.",
    "license": "GPL-2.0-or-later",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "watch": "vite build --watch",
        "typecheck": "tsc",
        "lint": "eslint .",
        "test": "vitest run",
        "check:build": "vite build && node bin/check-react-build.mjs",
        "qa:js": "npm run typecheck && npm run lint && npm run test && npm run check:build",
        "e2e": "playwright test",
        "e2e:install": "playwright install --with-deps"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.3.2",
        "lucide-react": "^1.47.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.45.0",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@wordpress/api-fetch": "^7.55.0",
        "@wordpress/element": "^8.7.0",
        "@wordpress/i18n": "^6.28.0",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.0",
        "postcss": "^8.5.28",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.0.0",
        "vitest": "^5.0.1"
    }
}
