#: src/Storefront/Renderer.php:110
msgid "From"
msgstr "A partir de"

#: woocommerce-parcelas.php:53
msgid "Installment Prices for WooCommerce: dependencies are missing. Run \"composer install\" in the plugin directory."
msgstr "Parcelas para WooCommerce: faltam dependências. Execute \"composer install\" no diretório do plugin."

#: public/build/main.js:1
msgid "picker"
msgstr "seletor"

#: public/build/main.js:1
msgid "Theme"
msgstr "Tema"

#: public/build/main.js:1
msgid "use the theme color"
msgstr "usar a cor do tema"

#: public/build/main.js:1
msgid "Product lists"
msgstr "Listas de produtos"

#: public/build/main.js:1
msgid "The shop, category and search pages, and lists such as related products."
msgstr "A loja, as páginas de categoria e de busca e listas como a de produtos relacionados."

#: public/build/main.js:1
msgid "Product page"
msgstr "Página do produto"

#: public/build/main.js:1
msgid "When variations cost different amounts, the chosen variation’s own lines also appear under its price."
msgstr "Quando as variações têm preços diferentes, os valores da variação escolhida também aparecem abaixo do preço dela."

#: public/build/main.js:1
msgid "Position"
msgstr "Posição"

#: public/build/main.js:1
msgid "Priority"
msgstr "Prioridade"

#: public/build/main.js:1
msgid "Order within the position: WooCommerce shows the price at 10, so 15 comes right after it."
msgstr "Ordem dentro da posição: o WooCommerce exibe o preço em 10, então 15 vem logo depois dele."

#: public/build/main.js:1
msgid "Alignment"
msgstr "Alinhamento"

#: public/build/main.js:1
#, js-format
msgid "%1$s (%2$s)"
msgstr "%1$s (%2$s)"

#: public/build/main.js:1
msgid "Installment price"
msgstr "Preço parcelado"

#: public/build/main.js:1
msgid "Splits the price into interest-free installments, e.g. \"Up to 10 installments of $9.90 interest-free\"."
msgstr "Divide o preço em parcelas sem juros, ex.: \"Em até 10x de R$ 9,90 sem juros\"."

#: public/build/main.js:1
msgid "Show the installment price"
msgstr "Exibir o preço parcelado"

#: public/build/main.js:1
msgid "Text before"
msgstr "Texto antes"

#: public/build/main.js:1
msgid "e.g. \"Up to\". Products with a price range say \"From\" instead."
msgstr "Ex.: \"Em até\". Produtos com faixa de preço exibem \"A partir de\" no lugar."

#: public/build/main.js:1
msgid "Text after"
msgstr "Texto depois"

#: public/build/main.js:1
msgid "e.g. \"interest-free\"."
msgstr "Ex.: \"sem juros\"."

#: public/build/main.js:1
msgid "At least 2. A product can set its own in its Installments tab."
msgstr "No mínimo 2. Cada produto pode definir o seu na aba Parcelamento."

#: public/build/main.js:1
msgid "Minimum installment"
msgstr "Parcela mínima"

#: public/build/main.js:1
msgid "Fewer installments are offered when one would cost less. 0 turns the limit off."
msgstr "Menos parcelas são oferecidas quando uma ficaria abaixo desse valor. 0 desativa o limite."

#: public/build/main.js:1
msgid "Show it on out-of-stock products too"
msgstr "Exibir também em produtos fora de estoque"

#: public/build/main.js:1
msgid "Cash price"
msgstr "Preço à vista"

#: public/build/main.js:1
msgid "A discounted price for paying the full amount at once, e.g. \"or $89.10 by bank transfer\"."
msgstr "Um preço com desconto para pagamento à vista, ex.: \"ou R$ 89,10 no Pix\"."

#: public/build/main.js:1
msgid "Show the cash price"
msgstr "Exibir o preço à vista"

#: public/build/main.js:1
msgid "e.g. \"or\"."
msgstr "Ex.: \"ou\"."

#: public/build/main.js:1
msgid "e.g. \"by bank transfer\"."
msgstr "Ex.: \"no Pix\"."

#: public/build/main.js:1
msgid "Discount"
msgstr "Desconto"

#: public/build/main.js:1
msgid "A product can set its own in its Installments tab."
msgstr "Cada produto pode definir o seu na aba Parcelamento."

#: public/build/main.js:1
msgid "Amount"
msgstr "Valor"

#: public/build/main.js:1
msgid "Color"
msgstr "Cor"

#: public/build/main.js:1
msgid "Weight"
msgstr "Peso"

#: public/build/main.js:1
msgid "Size"
msgstr "Tamanho"

#: public/build/main.js:1
msgid "Leave a field empty to keep your theme’s style."
msgstr "Deixe um campo vazio para manter o estilo do tema."

#: public/build/main.js:1
msgid "e.g. 18px"
msgstr "ex.: 18px"

#: public/build/main.js:1
msgid "Settings saved."
msgstr "Configurações salvas."

#: public/build/main.js:1
msgid "Some style values weren’t valid, so they were cleared. Use colors like #1e1e1e and sizes like 18px or 1.2em."
msgstr "Alguns valores de estilo não eram válidos e foram removidos. Use cores como #1e1e1e e tamanhos como 18px ou 1.2em."

#: public/build/main.js:1
msgid "Something went wrong. Please try again."
msgstr "Algo deu errado. Tente novamente."

#: public/build/main.js:1
msgid "Notifications"
msgstr "Notificações"

#: public/build/main.js:1
msgid "Dismiss this notice."
msgstr "Dispensar este aviso."

#: public/build/main.js:1
msgid "General"
msgstr "Geral"

#: public/build/main.js:1
msgid "Display"
msgstr "Exibição"

#: public/build/main.js:1
msgid "Style"
msgstr "Estilo"

#: public/build/main.js:1
msgid "Settings sections"
msgstr "Seções das configurações"

#: public/build/main.js:1
msgid "Saving…"
msgstr "Salvando…"

#: public/build/main.js:1
msgid "Save settings"
msgstr "Salvar configurações"

#: public/build/main.js:1
msgid "You have unsaved changes."
msgstr "Há alterações não salvas."

#: public/build/main.js:1
#, js-format
msgid "Version %s"
msgstr "Versão %s"

#: public/build/main.js:1
msgid "Get support"
msgstr "Obter suporte"

#: public/build/main.js:1
msgid "WooCommerce is a trademark of its respective owner. This plugin is not affiliated with or endorsed by WooCommerce."
msgstr "WooCommerce é uma marca de seu respectivo proprietário. Este plugin não é afiliado ao WooCommerce nem endossado por ele."
