#. Plugin Name of the plugin
#: woocommerce-parcelas.php
#: src/Admin/SettingsPage.php
msgid "Installment Prices for WooCommerce"
msgstr "Parcelas para WooCommerce"

#. Plugin URI of the plugin
#: woocommerce-parcelas.php
msgid "https://wordpress.org/plugins/woocommerce-parcelas/"
msgstr "https://wordpress.org/plugins/woocommerce-parcelas/"

#. Description of the plugin
#: woocommerce-parcelas.php
msgid "Show installment prices and a discounted cash price on your WooCommerce product lists and product pages."
msgstr "Exiba o preço parcelado e o preço à vista com desconto nas listas de produtos e nas páginas de produto do WooCommerce."

#. Author of the plugin
#: woocommerce-parcelas.php
msgid "Filipe Seabra"
msgstr "Filipe Seabra"

#. Author URI of the plugin
#: woocommerce-parcelas.php
msgid "https://github.com/filipecsweb"
msgstr "https://github.com/filipecsweb"

#: src/Admin/ProductDataTab.php
msgid "Installments"
msgstr "Parcelamento"

#: src/Admin/ProductDataTab.php
msgid "Leave blank to use the store setting."
msgstr "Deixe em branco para usar a configuração da loja."

#: src/Admin/ProductDataTab.php
msgid "Hide installments"
msgstr "Ocultar parcelamento"

#: src/Admin/ProductDataTab.php
msgid "Show no installment price for this product."
msgstr "Não exibir o preço parcelado neste produto."

#: src/Admin/ProductDataTab.php
#: public/build/main.js
msgid "Maximum installments"
msgstr "Máximo de parcelas"

#: src/Admin/ProductDataTab.php
msgid "Hide cash price"
msgstr "Ocultar preço à vista"

#: src/Admin/ProductDataTab.php
msgid "Show no cash price for this product."
msgstr "Não exibir o preço à vista neste produto."

#: src/Admin/ProductDataTab.php
msgid "Cash discount"
msgstr "Desconto à vista"

#: src/Admin/ProductDataTab.php
#: public/build/main.js
msgid "Discount type"
msgstr "Tipo de desconto"

#: src/Admin/ProductDataTab.php
msgid "Store setting"
msgstr "Configuração da loja"

#: src/Admin/SettingsPage.php
msgid "Sorry, you are not allowed to access this page."
msgstr "Desculpe, você não tem permissão para acessar esta página."

#: src/Admin/SettingsPage.php
msgid "Installment Prices"
msgstr "Parcelas"

#: src/Admin/SettingsPage.php
msgid "Settings"
msgstr "Configurações"

#: src/Admin/SettingsPage.php
msgid "Show installment prices and a cash price on your product lists and product pages."
msgstr "Exiba o preço parcelado e o preço à vista nas listas de produtos e nas páginas de produto."

#: src/Settings/Settings.php
msgid "Below the product title"
msgstr "Abaixo do título do produto"

#: src/Settings/Settings.php
msgid "Below the Add to cart button"
msgstr "Abaixo do botão Adicionar ao carrinho"

#: src/Settings/Settings.php
msgid "In the product summary"
msgstr "No resumo do produto"

#: src/Settings/Settings.php
msgid "Above the add-to-cart form"
msgstr "Acima do formulário de compra"

#: src/Settings/Settings.php
msgid "Above the Add to cart button"
msgstr "Acima do botão Adicionar ao carrinho"

#: src/Settings/Settings.php
msgid "Below the add-to-cart form"
msgstr "Abaixo do formulário de compra"

#: src/Settings/Settings.php
msgid "Theme default"
msgstr "Padrão do tema"

#: src/Settings/Settings.php
msgid "Left"
msgstr "Esquerda"

#: src/Settings/Settings.php
msgid "Center"
msgstr "Centro"

#: src/Settings/Settings.php
